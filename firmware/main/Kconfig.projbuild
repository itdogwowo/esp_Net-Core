menu "esp_Net-Core"

    # ── USB device（TinyUSB 服務組）────────────────────────────────
    # 三個符號一起決定「編譯期能不能有 USB」與「P4 用哪條 PHY」。
    # 判斷一律用官方 SOC 能力符號（SOC_USB_OTG_SUPPORTED / SOC_USB_SERIAL_JTAG_SUPPORTED），
    # 所以 C 檔不需要任何 CONFIG_IDF_TARGET_* —— 有硬體的晶片自動編進去，冇的完全不編。
    # 執行期要不要真的開（交碟／log 管道）由 data/config/system.json 的 "usb" 段決定。

    config NETCORE_USB_OTG
        bool "USB device 服務組（TinyUSB：MSC + CDC）"
        default y if IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32P4
        default n
        help
            晶片有 USB OTG 控制器就預設編入（ESP32-S3／S2／P4 = y；C3／C6／H2 = n）。

            注意：`SOC_USB_OTG_SUPPORTED` 是自動產生的 C 巨集，**不是 Kconfig 符號**，
            Kconfig 表達式裡用不到它（用了會靜靜當成 n）。所以這裡列目標名。

            關掉時整組定義都不編，連 tinyusb 都不會 link（省約 21.7 KB：
            _cdcd_itf 12,532 + _mscd_epbuf 8,192 + _cdcd_epbuf 1,024）。

            開著也**不代表會用**：開機仍然由 system.json 的 usb.msc / usb.cdc_log 決定，
            兩個都可以 runtime 改成 0，不用重燒。

    config NETCORE_USB_OTG_HS
        bool "USB OTG 走 High-Speed PHY（P4：pin 50/49）"
        depends on NETCORE_USB_OTG
        default n
        help
            只有 P4 有 HS PHY（另外兩條 FS 是 USB-Serial-JTAG 與 FS_PHY2）。
            S3／S2 只有 FS，這個符號對它們沒有意義。

            選錯的症狀是「init 成功但主機見不到裝置」——因為 descriptor 沒錯，
            只是訊號走錯一對 D+/D-。

    config NETCORE_USB_CONSOLE_TEE
        bool "log 除咗 CDC 之外，照樣寫 console"
        depends on NETCORE_USB_OTG
        default y if IDF_TARGET_ESP32P4
        default n
        help
            log 管道一裝 hook，esp_log 就改走環＋CDC；呢個選項令同一行**同時**寫 console。

            P4 的 console（USB-Serial-JTAG, GPIO24/25）同 OTG（HS, pin 50/49）是
            **兩條獨立 PHY** → 可以兩邊都出，log 管道壞掉時仍然看得到板子在不在。

            S3 的 JTAG 同 OTG **共用一條 PHY**，TinyUSB 一 init JTAG 就沒了，
            tee 沒有意義（所以 S3 不列）。

    config NETCORE_WIFI
        bool "Wi-Fi 通道（會 link esp_wifi）"
        default n
        depends on SOC_WIFI_SUPPORTED || NETCORE_WIFI_HOSTED
        help
            把 Wi-Fi 驅動編進影像。**預設關閉**：關閉時 esp_wifi 完全不會被
            link，靜態 BSS 與 flash 都是 0。

            即使編入，開機仍然會讀 network.json 的 wifi.enable 與 ssid：
            未啟用（enable=0）或 ssid 空白時，**不會**呼叫 esp_wifi_init，
            所以連執行期 heap（約 90–120 KB）都不會佔用。

            兩層開關都要開才會真的用 Wi-Fi：
              ① 這個選項（決定會不會 link）
              ② network.json 的 wifi.enable（決定會不會初始化）

            理由：只做②的話，一個永遠不用的功能仍然要付靜態 RAM 與 flash。

    config NETCORE_WIFI_HOSTED
        bool "P4：Wi-Fi 走外掛協處理器（ESP-Hosted：C6／C5／其他型號）"
        default n
        depends on IDF_TARGET_ESP32P4
        help
            P4 冇內建 radio。開啟後 Wi-Fi 由板上的協處理器提供：esp_wifi_remote
            把 esp_wifi.h 的呼叫轉去 esp_hosted（預設 SDIO），所以 nc_wifi.c 與
            network.json 的用法完全不變 —— 同 S3 的原生 Wi-Fi 是同一個 API。

            兩件事要一起對：
              ① 板子 profile：wifi-hosted-c6 / wifi-hosted-c5（決定 slave target
                 與 SDIO 腳位），由 tools/board.py sync 寫進 sdkconfig.defaults
              ② 協處理器上要跑**版本匹配**的 esp_hosted slave firmware

            協處理器型號不只一種：換型號 = 換 profile，應用程式碼不動。

    # ── 8×8 WS2812 矩陣（測試任務）────────────────────────────────
    # 板子事實放 ports/<board>/sdkconfig.defaults；程式只認符號。
    # 只有測試映像（NC_ENABLE_TESTS=ON）才有這個任務。

    config NETCORE_RGB_MATRIX
        bool "8×8 WS2812 矩陣（I80 波形 + 分區時間抖動）"
        depends on SOC_LCD_I80_SUPPORTED
        default n
        help
            Waveshare ESP32-S3-Matrix：64 顆 WS2812B 串成 8×8，資料腳 GPIO14。
            用 LCD_CAM 的 I80（GDMA）產生 WS2812 波形，一幀 7,936 B ≈ 1.98 ms，
            所以上限 450 fps；效果亮度用 8.8 定點 + 逐幀誤差回饋抖動，
            暗階等效多 8 bit 灰階。

            注意 I80 一定要 8 條資料線 + WR + DC 都是有效 GPIO；
            只有 D0 真正接燈，其餘 7 條資料線與 WR／DC 是 dummy（會出現在排針上）。

    config NETCORE_RGB_MATRIX_I80_PINS
        string "I80 腳位（D0..D7,WR,DC 共 10 個，逗號分隔）"
        depends on NETCORE_RGB_MATRIX
        default "14,38,39,40,41,42,47,48,1,2"
        help
            D0 是真正的燈資料線；D1..D7、WR、DC 只是 I80 需要的 dummy。
            預設值避開 IMU（IO10–13）、USB（19/20）、UART0（43/44）、
            flash（26–32）、nc_hw_reserved() 視為 PSRAM 的 33–37，
            以及 strapping（0/3/45/46）。

    config NETCORE_RGB_MATRIX_PCLK_HZ
        int "I80 PCLK（Hz）"
        depends on NETCORE_RGB_MATRIX
        default 2500000
        range 1000000 20000000
        help
            WS2812 一個 bit 用 3 個 PCLK 週期。預設 2.5 MHz
            → bit 1.200 µs、T0H 0.400 µs、T1H 0.800 µs（最保守，同 demo 一致）。
            確認燈食得到之後可以先升 pclk 追 fps。改這個等於改 WS2812 時序。

    config NETCORE_RGB_MATRIX_FPS
        int "目標幀率上限（fps）"
        depends on NETCORE_RGB_MATRIX
        default 450
        range 60 460
        help
            資料本身 1.98 ms／幀（≈ 505 fps），加 reset 之後實際上限約 460 fps。
            預設 450 fps，留 ~240 µs 給 reset 與排程抖動。

endmenu
