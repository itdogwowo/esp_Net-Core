menu "esp_Net-Core"

    # ── USB device（TinyUSB 服務組）────────────────────────────────
    # 三個符號一起決定「編譯期能不能有 USB」與「P4 用哪條 PHY」。
    # 判斷一律用官方 SOC 能力符號（SOC_USB_OTG_SUPPORTED / SOC_USB_SERIAL_JTAG_SUPPORTED），
    # 所以 C 檔不需要任何 CONFIG_IDF_TARGET_* —— 有硬體的晶片自動編進去，冇的完全不編。
    # 執行期要不要真的開（交碟／log 管道）由 data/config/system.json 的 "usb" 段決定。

    config NETCORE_USB_OTG
        bool "USB device 服務組（TinyUSB：MSC + CDC）"
        default y if IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32P4
        default n
        help
            晶片有 USB OTG 控制器就預設編入（ESP32-S3／S2／P4 = y；C3／C6／H2 = n）。

            注意：`SOC_USB_OTG_SUPPORTED` 是自動產生的 C 巨集，**不是 Kconfig 符號**，
            Kconfig 表達式裡用不到它（用了會靜靜當成 n）。所以這裡列目標名。

            關掉時整組定義都不編，連 tinyusb 都不會 link（省約 21.7 KB：
            _cdcd_itf 12,532 + _mscd_epbuf 8,192 + _cdcd_epbuf 1,024）。

            開著也**不代表會用**：開機仍然由 system.json 決定（`links[].msc` 交唔交碟、
            `usb.cdc_log` 決定 log），兩個都可以 runtime 改，不用重燒。

    config NETCORE_USB_OTG_HS
        bool "USB OTG 走 High-Speed PHY（P4：pin 50/49）"
        depends on NETCORE_USB_OTG
        default n
        help
            只有 P4 有 HS PHY（另外兩條 FS 是 USB-Serial-JTAG 與 FS_PHY2）。
            S3／S2 只有 FS，這個符號對它們沒有意義。

            選錯的症狀是「init 成功但主機見不到裝置」——因為 descriptor 沒錯，
            只是訊號走錯一對 D+/D-。

    config NETCORE_USB_CONSOLE_TEE
        bool "log 除咗 CDC 之外，照樣寫 console"
        depends on NETCORE_USB_OTG
        default y if IDF_TARGET_ESP32P4
        default n
        help
            log 管道一裝 hook，esp_log 就改走環＋CDC；呢個選項令同一行**同時**寫 console。

            P4 的 console（USB-Serial-JTAG, GPIO24/25）同 OTG（HS, pin 50/49）是
            **兩條獨立 PHY** → 可以兩邊都出，log 管道壞掉時仍然看得到板子在不在。

            S3 的 JTAG 同 OTG **共用一條 PHY**，TinyUSB 一 init JTAG 就沒了，
            tee 沒有意義（所以 S3 不列）。

    config NETCORE_WIFI
        bool "Wi-Fi 通道（會 link esp_wifi）"
        default n
        depends on SOC_WIFI_SUPPORTED || NETCORE_WIFI_HOSTED
        help
            把 Wi-Fi 驅動編進影像。**預設關閉**：關閉時 esp_wifi 完全不會被
            link，靜態 BSS 與 flash 都是 0。

            即使編入，開機仍然會讀 network.json 的 wifi.enable 與 ssid：
            未啟用（enable=0）或 ssid 空白時，**不會**呼叫 esp_wifi_init，
            所以連執行期 heap（約 90–120 KB）都不會佔用。

            兩層開關都要開才會真的用 Wi-Fi：
              ① 這個選項（決定會不會 link）
              ② network.json 的 wifi.enable（決定會不會初始化）

            理由：只做②的話，一個永遠不用的功能仍然要付靜態 RAM 與 flash。

    config NETCORE_WIFI_HOSTED
        bool "P4：Wi-Fi 走外掛協處理器（ESP-Hosted：C6／C5／其他型號）"
        default n
        depends on IDF_TARGET_ESP32P4
        help
            P4 冇內建 radio。開啟後 Wi-Fi 由板上的協處理器提供：esp_wifi_remote
            把 esp_wifi.h 的呼叫轉去 esp_hosted（預設 SDIO），所以 nc_wifi.c 與
            network.json 的用法完全不變 —— 同 S3 的原生 Wi-Fi 是同一個 API。

            兩件事要一起對：
              ① 板子 profile：wifi-hosted-c6 / wifi-hosted-c5（決定 slave target
                 與 SDIO 腳位），由 tools/board.py sync 寫進 sdkconfig.defaults
              ② 協處理器上要跑**版本匹配**的 esp_hosted slave firmware

            協處理器型號不只一種：換型號 = 換 profile，應用程式碼不動。

    # ── 像素渲染器（pixel / nc_pixel）────────────────────────────
    # 板子事實放 ports/<board>/sdkconfig.defaults；程式只認符號。
    #
    # 分兩層：
    #   ① 編譯期（這裡）：這塊板有沒有 I80／SPI 硬體、預設腳位、預設時序；
    #   ② 執行期（data/config/tasks.json 的 "pixel"）：幾道 lane、幾 fps —— 不用重燒。
    # 「幾顆燈」是板子事實（同一條 lane 上串了幾顆），所以留在編譯期。

    config NETCORE_PIXEL
        bool "像素渲染器（pixel 任務：環 + 編碼器 + 多後端）"
        depends on SOC_LCD_I80_SUPPORTED || SOC_SPI_SUPPORTED
        default n
        help
            生產者（內建效果／`.nce`／主機推送）不斷把 R,G,B,W 四位的畫面寫進環，
            渲染器按自己的節奏取最新一格、用後端的格式編碼、交給驅動。兩邊分開。

            取代舊的 `rgbmatrix` 測試任務：效果變成生產者，送燈變成後端。
            沒有燈板的板子也可以開（後端退到 mock / direct），整條路照樣跑。

    config NETCORE_PXBENCH
        bool "像素吞吐量測指令 0xF062（release 映像也可用）"
        depends on NETCORE_PIXEL
        default n
        help
            加一條 0xF062 PXBENCH 指令量「packed 波形＋8×8 轉置」的每幀成本；
            緩衝先試 internal SRAM、唔夠才退 PSRAM，回覆有 sram=1/0。
            量產映像預設關閉。

    config NETCORE_EFFECT_BENCH
        bool "效果效能專用測試（0xF065 EFBENCH；release 映像也可用）"
        depends on NETCORE_PIXEL
        default n
        help
            加入一個**只測效果管線**的效能任務與指令：
            0xF065 EFBENCH 會量 program interpreter（逐值／逐幀）、
            8-bit／12-bit 配對、12→8（四捨五入／抖動）、
            internal SRAM／PSRAM／混合放置、分塊（chunk）與多 job 合成。

            這一支**不屬於** NC_ENABLE_TESTS 的 58 條測試指令：它自己一個
            component、自己一條 0xF065／0xF066，沒有 0xF060–0xF064、沒有
            network／ncm／其他量測。專案
            `ESP32-S3-Matrix-EffectPerf` 用它開一個「純效果」映像：
            render／pixel 任務關閉（唔點燈、唔跑基礎效果），
            只留 nc4＋這個 bench。

            量產映像預設關閉。

    config NETCORE_CONTENT
        bool "檔案驅動 show 任務（/data/pixel 四層：effects／map／modes／registry）"
        depends on NETCORE_PIXEL
        default n
        help
            加入 production 的四層管線（2026-11-25 四任務正名）：
            · pixel_effect_task：只 evaluate program 波形值（50 fps）；
            · pixel_pair_task  ：載入 `/data/pixel` 四層、建 plan、按 group/range/write
              配對（抖動在內圈）、white mix（0..100），寫入 prd 環；
              0xF06B/0xF06D/0xF06F 也在這裡；
            · pixel_encode_task（畫波）／render_task（公用推送）屬 NETCORE_PIXEL，
              即使這一項關閉都存在（只是冇生產者餵環）。
            四任務由 project 的 tasks.json 各自設 level／affinity；effect 預設 core0，
            pair／wave／render core1。

            內容缺失（/data/pixel 未上傳）時只 log warning 並填黑，
            不會讓開機失敗。量產映像預設關閉。

    config NETCORE_PIXEL_LEDS
        int "每道 lane 的燈數"
        depends on NETCORE_PIXEL
        default 64
        range 1 16384
        help
            一條 lane 串幾顆。環的每一格 = 64 B 表頭 + 4 B × 燈數（進位到 64 的倍數）。

            ⚠ 冇硬上限（程式唔會擋），但超過要付代價：CPU 同 lane×px 成正比、
            DMA 同 px 成正比。實測上限與「超過會 WDT 重啟」的後果見
            docs/03_notes/pixel-renderer.md §13。

            上限 2048 是編碼器的 buffer（NC_PX_MAX_LEDS）；實務上還要看記憶體：
            2048 顆 × 3 格 = 25 KB／lane。

    config NETCORE_PIXEL_FORMAT
        string "燈的格式（ws2812 / ws2812w / ws2815 / ws2801 / apa102）"
        depends on NETCORE_PIXEL
        default "ws2812w"
        help
            只決定「線材上送什麼」：WS2812 是 GRB（3 B，**沒有白**）、
            WS2812W / SK6812 是 GRBW（4 B，白真的進線）、WS2801 / APA102 是時脈式。

            canonical 一律是 R,G,B,W 四位（白不進線的格式就丟掉 W）——
            所以「畫面要白色」是產生者的事（R=G=B），不是渲染器的事。

            ⚠ 這個值必須和 NETCORE_PIXEL_I80 / _SPI 對得上：
              歸零碼格式（ws2812*／ws2815）走 I80；時脈格式（ws2801／apa102）走 SPI。

    config NETCORE_PIXEL_PCLK_HZ
        int "歸零碼的取樣時鐘（Hz）＝ I80 PCLK"
        depends on NETCORE_PIXEL_I80
        default 2500000
        range 1000000 20000000
        help
            一個 bit = NETCORE_PIXEL_BIT_CELLS 個時鐘。預設 2.5 MHz × 3 = 1.200 µs
            （T0H 0.400 µs、T1H 0.800 µs，最保守）。要 ~450 fps 就升到 8.889 MHz
            並把 bit_cells 改成 8（0.900 µs／337 ns／675 ns）。

    config NETCORE_PIXEL_BIT_CELLS
        int "歸零碼：一個 bit 幾個時鐘"
        depends on NETCORE_PIXEL_I80
        default 3
        range 2 16
        help
            I80 一個時鐘送一個 byte（8 條資料線）。WS2812 的位元寬度靠這裡湊出來。

    config NETCORE_PIXEL_T0H
        int "歸零碼：0 碼的高電平時鐘數"
        depends on NETCORE_PIXEL_I80
        default 1
        range 1 15
        help
            必須 ≥ 1：整組 bit 都是低電平會被燈當成 reset（畫面會閃／掉格）。
            編碼器會把 0 夾回 1。

    config NETCORE_PIXEL_T1H
        int "歸零碼：1 碼的高電平時鐘數"
        depends on NETCORE_PIXEL_I80
        default 2
        range 1 15
        help
            必須 ≤ BIT_CELLS（= BIT_CELLS 是 100 % 佔空比，沒有下降緣）。
            必須 > T0H，否則兩個碼分不出來。編碼器會夾回合法範圍。

    config NETCORE_PIXEL_DITHER_BITS
        int "亮度精度（8 = 關抖動；12+ 是實驗）"
        depends on NETCORE_PIXEL
        default 8
        range 8 16
        help
            燈只有 8 bit／通道。暗階（例如 1/256）在 8 bit 下不是 0 就是 1，
            看起來會「跳」。用 8.8 定點 + 逐幀誤差回饋把平均做回來，
            等效多幾 bit 灰階（詳見 docs/03_notes/rgb-matrix-dither.md）。

            成本：每顆每通道幾次整數運算；8 bit 是零成本（直接四捨五入）。

    config NETCORE_PIXEL_DITHER
        int "抖動方式（0 關 / 1 時間 / 2 時間+空間；暫時預設關）"
        depends on NETCORE_PIXEL
        default 0
        range 0 2
        help
            1 = 時間抖動：同一個相位區的誤差一起累積（幀率高時看得到微微閃）。
            2 = 再加 4×4 Bayer 空間圖案：低幀率（≤ 240 fps）下更穩，代價是
               靜態畫面上有一層很淡的網紋。

    config NETCORE_PIXEL_ZONE_PX
        int "抖動相位區：每幾顆一個"
        depends on NETCORE_PIXEL
        default 4
        range 0 2048
        help
            相鄰的燈不要同時閃，所以把燈鏈切成若干區、每區一個誤差累加器。
            0 = 整條一區。上限 16 區（NC_PX_CODEC_ZONES_MAX）。

    config NETCORE_PIXEL_MOCK_ONLY
        bool "只規劃 mock lane（量 CPU；唔點燈）"
        depends on NETCORE_PIXEL
        default n
        help
            硬件層已另行驗證時用：render 只建 mock lane，按 fps 消費環，
            咁 effect／pair 就可以量到真實 CPU 成本（唔受線路時間限制）。

    config NETCORE_PIXEL_APPLY_PIPE
        bool "flat 表 chunk 預取（PSRAM → internal，另一個 core）"
        depends on NETCORE_PIXEL
        default n
        help
            flat 表放 PSRAM；pair apply 時用 3 塊 internal chunk buffer，
            由 core0 的 worker 預先 memcpy，pair 只讀 internal。
            實測（9,600 px、1 run）可將 apply 由 ~5 ms 降到 ~1.6 ms。

    config NETCORE_PIXEL_SLACK_MS
        int "時間銀行上限（ms）：空閒時存、尖峰時釋放"
        depends on NETCORE_PIXEL
        default 50
        range 0 2000
        help
            render 用 deadline 時鐘：早完成就存多餘時間（上限呢個值），
            遲到就先花存下的時間頂住、下一輪追返；存唔夠就重排（唔爆追）。
            0 = 關閉（等於固定節拍）。

    config NETCORE_USB_MSC_FORCE_OFF
        bool "強制唔交 MSC（recovery：解 FAT 鎖）"
        depends on NETCORE_USB_OTG
        default n
        help
            就算 links[].msc=1 都唔把 FAT 交畀 USB host。用來解「FAT 被 MSC 鎖住、
            上傳／刪檔全部 err_busy」；解鎖後應改 config 的 msc=0 再關掉這個。

    config NETCORE_PIXEL_SUBFRAMES
        int "每個視覺幀的抖動子幀數（1=8-bit、4=10-bit）"
        depends on NETCORE_PIXEL
        default 1
        range 1 8
        help
            1 = 每個視覺幀送一次（8-bit）。
            4 = 時間抖動：每個視覺幀送 4 個子幀（等效 10-bit）。
            子幀率 = 視覺 fps × 子幀數；每條線的像素要相應減少（例如 600 → 150）。

    config NETCORE_PIXEL_RING_SLOTS
        int "prd 環格數（要 ≥ 子幀數 + 1）"
        depends on NETCORE_PIXEL
        default 3
        range 3 16
        help
            環是 px × 4 × 格數；9,600 px 3 格 = 115 KB（PSRAM）。
            用 4 子幀抖動時建議 5 格（4 格在飛 + 1 格緩衝）。

    config NETCORE_PIXEL_FPS
        int "後備幀率（實際以 system.json 的 frame_interval_ms 為準）"
        depends on NETCORE_PIXEL
        default 50
        range 1 1000
        help
            送燈的節奏。這和「產生者更新畫面的節奏」是兩件事：內建效果 60 fps，
            渲染器 450 fps 只會重播同一格（hold）。8×8 一幀 7,936 B ≈ 1.98 ms
            ⇒ 450 fps 留 ~240 µs 給 reset 與排程。

    config NETCORE_PIXEL_CORE
        int "渲染器跑哪一核（-1 = 不綁）"
        depends on NETCORE_PIXEL
        default -1
        range -1 1
        help
            主機推送／`.nce` 要跟上高幀率時，把渲染器綁到效果不用的那一核。

    config NETCORE_PIXEL_STACK
        int "渲染器堆疊（B）"
        depends on NETCORE_PIXEL
        default 4096
        range 2048 16384
        help
            渲染器只做「取格 → 編碼 → 交出去」，不跑效果，所以堆疊不大。

    config NETCORE_PIXEL_I80
        bool "I80 後端（LCD_CAM 8080 + DMA 產生歸零碼波形）"
        depends on NETCORE_PIXEL && SOC_LCD_I80_SUPPORTED
        default y
        help
            用 I80 的 8 條資料線當 8 條 lane：每條 lane 一位，OR 進同一個 byte，
            所以一次 DMA 同時送 8 條燈鏈 —— 這是 I80 相對 RMT 的唯一好處。

            注意 I80 一定要 8 條資料線 + WR + DC 都是有效 GPIO；
            沒接燈的資料線會出現在排針上（會一直跳，不要接到東西）。

    config NETCORE_PIXEL_I80_PINS
        string "I80 腳位（D0..D7,WR,DC 共 10 個，逗號分隔）"
        depends on NETCORE_PIXEL_I80
        default "14,38,39,40,41,42,47,48,1,2"
        help
            D0 = lane0、D1 = lane1…… 只有用到的前 NETCORE_PIXEL_I80_LANES 條是真的，
            其餘與 WR／DC 只是 I80 需要的 dummy。

            預設值避開 IMU（IO10–13）、USB（19/20）、UART0（43/44）、
            flash（26–32）、nc_hw_reserved() 視為 PSRAM 的 33–37，
            以及 strapping（0/3/45/46）。

    config NETCORE_PIXEL_I80_BUS_WIDTH
        int "I80 資料線寬度（8 或 16；16 需要 18 個腳位）"
        depends on NETCORE_PIXEL_I80
        default 8
        range 8 16
        help
            8 = D0..D7（一條 bus 最多 8 lane）；16 = D0..D15（最多 16 lane）。
            16-bit 每分鐘一個 PCLK 出兩條 lane 組，所以 16 lane 的**傳輸時間同 8 lane 一樣**；
            但 CPU 仍然要逐條 lane 編碼（編碼時間同 lane 數成正比）。
            16-bit 的腳位字串要有 18 個：D0..D15、WR、DC。

    config NETCORE_PIXEL_I80_LANES
        int "I80 一次送幾條 lane"
        depends on NETCORE_PIXEL_I80
        default 1
        range 1 16
        help
            1 = 只有 D0 接燈（Waveshare S3-Matrix 就是這種）。
            上限 = bus_width（8-bit 最多 8、16-bit 最多 16）。
            8 = 八條燈鏈完全同步，幀率不變 —— 這是 I80 的價值所在。

            ⚠ lane 數只影響 CPU（pack 隨 lane 線性、merge 每 8 條一組），
            **不影響 DMA 時間**（那只看 px）；「4 條 600、其他 0」不會更快。
            實測見 docs/03_notes/pixel-renderer.md §13。

    config NETCORE_PIXEL_PACK_PSRAM
        bool "I80 packed 波形固定放 PSRAM（大資料；不做 internal fallback）"
        depends on NETCORE_PIXEL_I80
        default n
        help
            固定記憶體政策：關閉 = packed 波形永遠 internal；開啟 = 永遠 PSRAM。
            不再「internal 失敗才退 PSRAM」；大畫面（例如 9,600 px）請明確開啟。

    config NETCORE_PIXEL_RING_PSRAM
        bool "環（prd）固定放 PSRAM（大畫面；不做 internal fallback）"
        depends on NETCORE_PIXEL && SPIRAM
        default n
        help
            production 的 prd 環是 px × 4 × 3 格。9,600 px 就要 115 KB：
            internal 冇咁多（實測剩 ~98 KB）→ render 啟動會 NO_MEM。
            開啟 = 環永遠 PSRAM；關閉 = 永遠 internal（小畫面，預設）。
            同 PACK_PSRAM 一樣是 **build-time 固定政策**，不是 runtime 按 free heap 選。

    config NETCORE_PIXEL_SPI
        bool "SPI 後端（WS2801／APA102 之類有時脈線的燈）"
        depends on NETCORE_PIXEL && SOC_SPI_SUPPORTED
        default n
        help
            時脈式燈：一個 bit = 一個 SPI 時脈，沒有「位元寬度」問題。
            一條 SPI 只有一個 MOSI，所以這個後端一次一條 lane。

    config NETCORE_PIXEL_SPI_MOSI
        int "SPI MOSI（資料）"
        depends on NETCORE_PIXEL_SPI
        default 11

    config NETCORE_PIXEL_SPI_SCLK
        int "SPI SCLK（時脈）"
        depends on NETCORE_PIXEL_SPI
        default 12

    config NETCORE_PIXEL_SPI_HZ
        int "SPI 時鐘（Hz）"
        depends on NETCORE_PIXEL_SPI
        default 2400000
        range 100000 40000000
        help
            WS2801 上限 25 MHz、APA102 上限 20 MHz（保守起見預設 2.4 MHz）。
            一顆燈 3–4 B ⇒ 64 顆約 0.7 ms。

