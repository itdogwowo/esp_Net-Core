# esp_Net-Core — 共通預設
#
# 【規則】這裡只放「與板子無關」的東西。
#   L1 硬體事實（flash 大小/頻率/模式、PSRAM、CPU、console、有冇 Ethernet）
#        → ports/<chip>/<board>/sdkconfig.defaults（由 board.json 描述）
#   L2 能力碎片（ETH / WS / UDP）
#        → ports/_profiles/*.defaults，由 tools/board.py sync 組合
#   L3 執行期可變（gpio、服務開關、數量）
#        → ports/<chip>/<board>/data/config.json
#
# tools/board.py check 會擋下任何「偷渡板子事實」到這份檔案的行為。

# ── 分割表 ──
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── FATFS（data 分區 + fatfs_create_partition_image）──
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_LABEL=y

# ── 系統 ──
CONFIG_FREERTOS_HZ=1000
# main 只負責開機（FAT/config/seed）＋之後心跳；實測峰值 ~2.1 KB
CONFIG_ESP_MAIN_TASK_STACK_SIZE=3072
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── USB：TinyUSB composite（MSC + CDC）──
# MSC 讀寫移到 worker task，否則 Windows 拖檔時 CDC / 心跳會被卡住
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_MSC_ASYNC_IO=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
# 預設 512B 的 RX ring 在 burst 時會掉幀（實測 256 幀只收到 147）
CONFIG_TINYUSB_CDC_RX_BUFSIZE=8192
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="esp_Net-Core"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="esp_Net-Core"
CONFIG_TINYUSB_DESC_MSC_STRING="esp_Net-Core assets"

# 任務表（STATUS keys=rt）：名稱/核/優先序/stack 剩餘
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_VOLUME_COUNT=3

# 任務卡死要自己重開，唔好等人斷電。
# 2026-11-07 實測兩次：decode 卡在無界自旋（log 洪水／壓測工具被 kill）之後，
# TWDT 只印警告（PANIC 關）→ 裝置永遠唔答指令，只能人手拔電。
CONFIG_ESP_TASK_WDT_PANIC=y
