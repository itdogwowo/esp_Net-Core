# esp_Net-Core — 共通預設（晶片層）
# 板子差異放 ports/<chip>/<board>/sdkconfig.defaults（後者覆蓋前者）
# 執行期可改的東西不屬於這裡 —— 那是 data/config.json

# ── flash / PSRAM（N16R8：16MB flash + 8MB Octal PSRAM）──
# 板子不是 16MB 或沒有 Octal PSRAM → 在 port 覆蓋這三行
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ── console ──
# bring-up 走 USB-Serial-JTAG。S3 的 USB-OTG 與它共用同一個 PHY，只能二選一；
# 之後接上 esp_tinyusb 時改成 CONFIG_ESP_CONSOLE_USB_CDC=y。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── 分割表 ──
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── FATFS（data 分區 + fatfs_create_partition_image）──
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_LABEL=y

# ── 系統 ──
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── USB：TinyUSB composite（MSC + CDC）──
# MSC 讀寫移到 worker task，否則 Windows 拖檔時 CDC / 心跳會被卡住
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_MSC_ASYNC_IO=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
# 預設 512B 的 RX ring 在 burst 時會掉幀（實測 256 幀只收到 147）
CONFIG_TINYUSB_CDC_RX_BUFSIZE=8192
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="esp_Net-Core"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="esp_Net-Core"
CONFIG_TINYUSB_DESC_MSC_STRING="esp_Net-Core assets"
