# ESP32-S3-Mini-Nano — 硬體事實（改這裡要重新 build）
# 對應 board.json；tools/board.py check 會驗證兩者一致。
# 通用白牌 S3-N16R8 Nano 板：16 MB flash + 8 MB octal PSRAM，無自訂分割表
# （用 firmware/partitions.csv，16 MB 表）。

# ── flash ──
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# ── PSRAM ──
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ── CPU ──
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── console：none ──
# 這塊板改用 TinyUSB OTG（MSC 隨身碟 + CDC log）；S3 的 OTG 與 USJ 共用同一條
# PHY，所以不能同時用 USJ console。App log 由 CDC（B09 之後）出；bootloader 的
# 早期訊息不會有。要拿回 USJ console 就把這行改回 USB_SERIAL_JTAG，並把
# system.json 的 USB link kind 改回 usb_jtag（MSC 會失效）。
CONFIG_ESP_CONSOLE_NONE=y
# 不要 USJ secondary：OTG 與 USJ 共用 PHY
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── Wi-Fi（晶片原生 radio；runtime 仍由 network.json 的 wifi.enable 決定）──
CONFIG_NETCORE_WIFI=y
