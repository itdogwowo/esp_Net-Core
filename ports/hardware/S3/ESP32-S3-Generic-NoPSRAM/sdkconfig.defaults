# ESP32-S3-Generic-NoPSRAM — 硬體事實（中央示範 pair；改這裡要重新 build）
# 對應 board.json／wiring.json；tools/board.py check 會驗證一致。

# ── flash（4 MB）──
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# ── PSRAM ──
CONFIG_SPIRAM=n

# ── CPU ──
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── console：none（TinyUSB OTG CDC log）──
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── 分區表：4 MB（同 Zero）──
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../ports/hardware/S3/ESP32-S3-Generic-NoPSRAM/partitions.csv"

# ── 像素渲染器（示範幾何：1 lane × 64 px WS2812）──
CONFIG_NETCORE_PIXEL=y
CONFIG_NETCORE_PIXEL_LEDS=64
CONFIG_NETCORE_PIXEL_FORMAT="ws2812"
CONFIG_NETCORE_PIXEL_I80=y
CONFIG_NETCORE_PIXEL_I80_DIRECT=y
CONFIG_NETCORE_PIXEL_I80_PINS="14"
CONFIG_NETCORE_PIXEL_I80_LANES=1
CONFIG_NETCORE_PIXEL_PCLK_HZ=2500000
CONFIG_NETCORE_PIXEL_BIT_CELLS=3
CONFIG_NETCORE_PIXEL_T0H=1
CONFIG_NETCORE_PIXEL_T1H=2
CONFIG_NETCORE_PIXEL_DITHER=1
CONFIG_NETCORE_PIXEL_DITHER_BITS=12
CONFIG_NETCORE_PIXEL_RING_PSRAM=n
CONFIG_NETCORE_PIXEL_PACK_PSRAM=n
CONFIG_NETCORE_PIXEL_SPI=n
CONFIG_NETCORE_CONTENT=y
