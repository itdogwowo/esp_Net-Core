{
  "version": 1,
  "_comment": [
    "Driver 層（S3-Matrix）：掛在匯流排上的晶片與行為。腳位在 hardware.json。",
    "這塊板實際只有 USB（CDC）與板載燈陣；燈陣由測試任務直接驅動 I80，不經這裡。",
    "其餘全部 enable = 0，等有硬件再接。"
  ],
  "USB": {
    "enable": 1,
    "msc": 1,
    "cdc": 1
  },
  "TFT": {
    "enable": 0,
    "bus": {
      "type": "spi",
      "index": -1
    },
    "pins": {
      "dc": "tft_dc",
      "cs": "tft_cs",
      "rst": "tft_rst",
      "bl": "tft_bl"
    },
    "xl9555": {
      "rst": 0,
      "bl": 1
    },
    "profile": "ST7789"
  },
  "APA102": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "spi",
          "index": -1
        },
        "profile": "APA102"
      }
    ]
  },
  "PCA9685": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "i2c",
          "index": -1
        },
        "profile": "PCA9685"
      }
    ]
  },
  "Audio": {
    "mode": "block"
  },
  "PCM5102": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "i2s",
          "index": -1
        },
        "GPIO": {
          "xsmt": null
        },
        "profile": "PCM5102"
      }
    ]
  },
  "GT1151Q": {
    "enable": 0,
    "bus": {
      "type": "i2c",
      "index": -1
    },
    "int": "touch_int",
    "profile": "GT1151Q"
  },
  "HUSB238": {
    "enable": 0,
    "bus": {
      "type": "i2c",
      "index": -1
    },
    "profile": "HUSB238"
  },
  "uartMotor": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "uart",
          "index": -1
        },
        "profile": "UART_MOTOR"
      }
    ]
  },
  "LED": {
    "_comment": [
      "板載 8×8 WS2812B 燈陣（D0 = GPIO14）。硬件（腳位／線寬）在 wiring.json 的 I80 段；",
      "這裡只寫「用邊條 bus、幾條 lane、每條幾顆、乜格式」——build 時 ncportgen 併埋生成",
      "nc_led_cfg_t，render 任務讀它（唔再讀 CONFIG_NETCORE_PIXEL_I80_*）。",
      "真正驅動仍然係 driver/drv_i80（pixel 的 i80 後端）。"
    ],
    "enable": 1,
    "backend": "i80",
    "bus": { "type": "i80", "index": 0 },
    "lanes": 1,
    "px": 64,
    "format": "ws2812",
    "timing": { "pclk_hz": 2500000, "bit_cells": 3, "t0h": 1, "t1h": 2 }
  }
}
