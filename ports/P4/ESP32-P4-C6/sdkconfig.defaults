# ESP32-P4-C6 — 硬體事實（改這裡要重新 build）
# 由 tools/board.py new 產生；tools/board.py check 會驗證與 board.json 一致

# ── flash ──
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# ── PSRAM ──
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# ── CPU ──
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ── console ──
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ── 晶片版本：這顆是 P4 rev v1.0（pre-rev3）────────────────────────────
# 官方預設是 REV_MIN_300（只支援 rev3+），會直接拒絕開機：
#   "requires chip revision in range [v3.1 - v3.99]（this chip is revision v1.0）"
# 這組就是官方 boards/sdkconfig.p4_pre_rev3 的內容。
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# ── IDF 6.1 的 P4 sleep-clock ICG（rev1.0 + esp_hosted + PSRAM 的開機 abort）──
# 症狀：sleep_clock_icg_init() 要向 retention 記憶體要 32 個 REGDMA link，
#       早期內部 DRAM 不足 → ESP_ERR_NO_MEM(0x101) → abort。
# 設 n 讓那個 .c 完全不編；代價只是 light sleep 時數位周邊不做 clock gating。
CONFIG_PM_SLEEP_CLK_ICG_ENABLE=n

# ─── 能力碎片（由 tools/board.py sync 產生，不要手改這段）───
# 來源：ports/_profiles/*.defaults；board.json 的 profiles 決定要哪些
# >>> profile: eth-rmii
# 能力碎片：RMII 乙太網（ESP32 內建 EMAC + 外部 PHY）
#
# 這是「有 Ethernet」的板子共用的建置設定。board.json 的 profiles 寫上 eth-rmii
# 之後由 tools/board.py sync 寫進 ports/<board>/sdkconfig.defaults。
#
# 需要調整的代表性數字（見 docs/03_notes/p4-bringup.md）：
#   ETH_DMA_BUFFER_SIZE=1600   512 B 對 MTU 1500 太小（實測掉到 1.9 MB/s）
#   LWIP_TCP_WND_DEFAULT=65535 預設 5744 B 會被 RTT 鎖死在 1 MB/s

CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_ESP32_EMAC_DEFAULT_CONFIG=y

CONFIG_ETH_DMA_BUFFER_SIZE=1600
CONFIG_ETH_DMA_RX_BUFFER_NUM=16
CONFIG_ETH_DMA_TX_BUFFER_NUM=16

CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_MEMP_NUM_TCP_SEG=64
CONFIG_LWIP_TCP_SACK_OUT=y
# <<< profile: eth-rmii
# >>> profile: wifi-hosted-c6
# 能力碎片：ESP32-P4 + 外掛 ESP32-C6（Wi-Fi via ESP-Hosted / SDIO）
#
# 由 board.json 的 profiles 引用，tools/board.py sync 寫進
# ports/<board>/sdkconfig.defaults 的 marker 區塊。
#
# 來源：MicroPython ports/esp32/boards/sdkconfig.p4_wifi_common
# （只取 Wi-Fi 部分；BLE 未接，所以拿掉 NimBLE／BT 那組）。
#
# ★ 協處理器型號是這個 profile 的軸，不是 firmware 的軸：
#     wifi-hosted-c6 → CONFIG_SLAVE_IDF_TARGET_ESP32C6
#     wifi-hosted-c5 → CONFIG_SLAVE_IDF_TARGET_ESP32C5
#   換型號 = 換 profile（重建 sdkconfig），firmware 程式碼完全不動。
#
# ★ 前提：協處理器上要跑**版本匹配**的 esp_hosted slave firmware。
#   版本差太遠時 host 會握手失敗（boot 時 log 會講）。

CONFIG_NETCORE_WIFI=y
CONFIG_NETCORE_WIFI_HOSTED=y

CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

# 官方 P4 開發板的 SDIO 腳位組。板子接法不同時要覆蓋這幾個 GPIO，
# 見 esp_hosted 的 CONFIG_ESP_HOSTED_SDIO_*（不要直接改 profile，另開一個）。
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# 遠端 Wi-Fi 的緩衝是 WIFI_RMT_*；ESP_WIFI_* 那組是衍生值，寫了沒用。
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64

# lwIP：預設窗口太小，RTT 會把吞吐鎖死（同 eth-rmii 的理由）
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# <<< profile: wifi-hosted-c6

# ── USB：P4 的 OTG 走 High-Speed PHY（pin 50/49）──────────────
# CONFIG_NETCORE_USB_OTG 會由 Kconfig 按 IDF_TARGET 自動 y；
# 這裡只補「用邊條 PHY」這個**板子事實**（換板可能要改）。
# 之後會搬去 ports/_profiles/usb-otg-hs.defaults，由 board.json 宣告。
CONFIG_NETCORE_USB_OTG_HS=y
