# ESP32-P4-ETH — 硬體事實（改這裡要重新 build）
# 對應 board.json；tools/board.py check 會驗證兩者一致。
# 能力碎片（eth-rmii / nc4-ws / nc4-udp）由 tools/board.py sync 寫在檔尾，不要手改那段。

# ── flash（這顆樣品 32 MB）──
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# flash 只能 40 MHz —— IDF 對 rev<3 直接關掉 80/120M（Kconfig: depends on !ESP32P4_REV_MIN_0）
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# ── 晶片版本：pre-rev3 配方（mp_Make-Tools/README，MicroPython PR #19564）──
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# ── CPU：這顆樣品上限 360 MHz（400 → 開機迴圈）──
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ── PSRAM：HEX 32 MB @ 200 MHz；用 IGNORE_NOTFOUND 保護 ──
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

# ── console 必須 UART0：USB-Serial/JTAG console 會讓 bootloader 卡死 ──
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ─── 能力碎片（由 tools/board.py sync 產生，不要手改這段）───
# 來源：ports/_profiles/*.defaults；board.json 的 profiles 決定要哪些
# >>> profile: eth-rmii
# 能力碎片：RMII 乙太網（ESP32 內建 EMAC + 外部 PHY）
#
# 這是「有 Ethernet」的板子共用的建置設定。board.json 的 profiles 寫上 eth-rmii
# 之後由 tools/board.py sync 寫進 ports/<board>/sdkconfig.defaults。
#
# 需要調整的代表性數字（見 docs/03_notes/p4-bringup.md）：
#   ETH_DMA_BUFFER_SIZE=1600   512 B 對 MTU 1500 太小（實測掉到 1.9 MB/s）
#   LWIP_TCP_WND_DEFAULT=65535 預設 5744 B 會被 RTT 鎖死在 1 MB/s

CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_ESP32_EMAC_DEFAULT_CONFIG=y

CONFIG_ETH_DMA_BUFFER_SIZE=1600
CONFIG_ETH_DMA_RX_BUFFER_NUM=16
CONFIG_ETH_DMA_TX_BUFFER_NUM=16

CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_MEMP_NUM_TCP_SEG=64
CONFIG_LWIP_TCP_SACK_OUT=y
# <<< profile: eth-rmii
# >>> profile: nc4-ws
# 能力碎片：NC4 over WebSocket
#
# 沒有這個 CONFIG，transport/ws_nc4.c 會編成 stub（回 ESP_ERR_NOT_SUPPORTED），
# 不會編不過——但 WS 通道就不能用。
CONFIG_HTTPD_WS_SUPPORT=y
# <<< profile: nc4-ws
# >>> profile: nc4-udp
# 能力碎片：NC4 over UDP
#
# 預設 6 則的 recv mailbox 在 burst 時會掉包。
# 注意：**不要**開 IP 分段/重組（實測 8 KB datagram 會吃光 pbuf pool，
# 讓整個 UDP 收發崩掉，見 docs/02_guides/testing.md §2.16）。datagram 請留在 MTU 以內。
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
# <<< profile: nc4-udp
