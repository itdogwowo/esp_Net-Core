# ESP32-P4（rev 1.3 / eco2 樣品，32 MB flash，無 Wi-Fi，RMII 乙太網）
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# pre-rev3 配方（mp_Make-Tools/README，MicroPython PR #19564）
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# 這顆樣品的頻率上限：CPU 360 MHz（400 → 開機迴圈）；APB 90、XTAL 40
# 實測：400 MHz → 開機迴圈（這顆樣品上限 360）
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
# flash 只能 40 MHz —— IDF 對 rev<3 直接關掉 80/120M（Kconfig: depends on !ESP32P4_REV_MIN_0）
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# PSRAM：200 MHz（與 MicroPython 當時相同）；用 IGNORE_NOTFOUND 保護
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

# console 必須 UART0：USB-Serial/JTAG console 會讓 bootloader 卡死
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# 乙太網（RMII + IP101，走 generic 802.3 PHY）
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_ESP32_EMAC_DEFAULT_CONFIG=y

# DMA：512 B 對 MTU 1500 太小（實測掉到 1.9 MB/s）
CONFIG_ETH_DMA_BUFFER_SIZE=1600
CONFIG_ETH_DMA_RX_BUFFER_NUM=16
CONFIG_ETH_DMA_TX_BUFFER_NUM=16

# lwIP：預設視窗 5744 B 會被 RTT 鎖死在 1 MB/s
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_MEMP_NUM_TCP_SEG=64
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_FREERTOS_HZ=1000

# WS 通道（NC4 over WebSocket）：httpd 的 WS 支援
CONFIG_HTTPD_WS_SUPPORT=y

# UDP 通道：預設 6 則的 recv mailbox 在 burst 時會掉包
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# UDP：**不要**開 IP 分段/重組。實測 8 KB 的 datagram 會吃掉 pbuf pool，
# 讓整個 UDP 收發崩掉（見 testing.md §2.16）。datagram 請留在 MTU 以內。
