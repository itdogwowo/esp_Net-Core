# 能力碎片：ESP32-P4 + 外掛 ESP32-C5（Wi-Fi 6 dual-band via ESP-Hosted）
#
# 與 wifi-hosted-c6 只差在 slave target；其他（SDIO 腳位、緩衝、lwIP）相同。
# 由 board.json 的 profiles 引用，tools/board.py sync 寫進板子的 sdkconfig.defaults。
#
# ★ 協處理器型號不只 C6／C5：遇到其他型號（官方支援清單見 esp_hosted 的
#   CONFIG_SLAVE_IDF_TARGET_*），照這個檔複製一份、只改 slave target 那一行即可。

CONFIG_NETCORE_WIFI=y
CONFIG_NETCORE_WIFI_HOSTED=y

CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y

# ⚠ SDIO 腳位係**板子**的事，唔關能力事：esp_hosted 用「板子符號」
#   （CONFIG_ESP_HOSTED_*_BOARD）去揀一整組腳位，所以那行要寫在
#   ports/hardware/<chip>/<board>/sdkconfig.defaults，唔可以寫在這裡。
#   2026-11 實測：舊版把 CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD 寫在
#   這個碎片裡，Waveshare P4-WIFI6-DB 的 C5 就因為腳位錯（拿咗官方
#   P4-Function-EV-Board 的 33/4/20/23/21/22+53，實板係
#   18/19/14/15/16/17+54）而 SDIO CMD5 超時（send_op_cond 0x107）。
#   板子接法全自訂 → 揀 ESP_HOSTED_P4_DEV_BOARD_NONE 再明寫
#   CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK/CMD/D0..D3 同 HOST_RESET_GPIO。

CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
