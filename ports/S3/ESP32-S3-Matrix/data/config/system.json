{
  "_comment": [
    "System 層：身份、開機行為、NC4 通道與路由表（S3-Matrix）。",
    "這塊板沒有 ETH、沒有 SD；USB 一台、沒有 UART 擴展（IO14 是燈，不要當 UART）。"
  ],
  "version": 1,
  "cID": "",
  "frame_interval_ms": 20,
  "num_pixels": 64,
  "nc4": {
    "links": [
      {
        "name": "usb_jtag",
        "kind": "usb_jtag",
        "enable": 1
      }
    ],
    "routes": [
      {
        "in": "nctx",
        "out": [
          "decode0"
        ]
      },
      {
        "in": "outbound",
        "out": []
      },
      {
        "in": "usb_jtag",
        "out": [
          "decode0"
        ]
      }
    ]
  },
  "usb": {
    "msc": 0,
    "cdc_log": 1
  },
  "log_debug_mode": 0
}
