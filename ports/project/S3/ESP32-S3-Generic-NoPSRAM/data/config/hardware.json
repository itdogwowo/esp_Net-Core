  "I80": {
    "_comment": "WS2812 用 I80（LCD_CAM 8080）當 8 條 lane 的動機。data = D0..D7（長度就是 bus_width）；只有 D0 = GPIO1 真的接燈，D1..D7／WR／DC 是 I80 硬性要求的 dummy。dc 是 esp_lcd 必要的 D/C 腳。freq 是 LCD 的意義；送燈的 PCLK 由 driver.json 的 LED.timing 給。runtime 可以用 /data/config/hardware.json 覆蓋。",
    "enable": 1,
    "list": [
      {
        "data": [
          14
        ],
        "wr": -1,
        "dc": -1,
        "cs": -1,
        "freq": 80000000
      }
    ]
