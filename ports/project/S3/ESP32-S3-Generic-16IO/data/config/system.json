{
  "_comment": [
    "中央示範（S3 通用，有 PSRAM）：system.json = 身份、節拍、通道與路由。",
    "示範只開 USB 一條線（Wi-Fi 要 build 有 CONFIG_NETCORE_WIFI 才開得；見 network.json）。",
    "links[].rx 唔寫 = 用固件預設（已按量測收緊）；只有特殊負載才覆寫。",
    "routes[].in → out 的 decodeN 決定哪一核解；單核板會自動收斂 decode1→decode0。"
  ],
  "version": 1,
  "cID": "",
  "frame_interval_ms": 20,
  "num_pixels": 4096,
  "nc4": {
    "links": [
      {
        "name": "usb0",
        "kind": "usb",
        "index": 0,
        "msc": 0
      }
    ],
    "routes": [
      {
        "in": "nctx",
        "out": [
          "decode0"
        ]
      },
      {
        "in": "usb0",
        "out": [
          "decode0"
        ]
      },
      {
        "in": "outbound",
        "out": []
      }
    ]
  },
  "usb": {
    "cdc_log": 1
  },
  "log_debug_mode": 0
}
