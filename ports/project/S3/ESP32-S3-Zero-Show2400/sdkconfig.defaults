# 10-bit 抖動：4 子幀、200 Hz 子幀率、環 5 格。
CONFIG_NETCORE_CONTENT=y
CONFIG_NETCORE_PXBENCH=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_NETCORE_PIXEL_PACK_PSRAM=y
CONFIG_NETCORE_PIXEL_RING_PSRAM=y
CONFIG_NETCORE_PIXEL_LEDS=2400
CONFIG_NETCORE_PIXEL_SUBFRAMES=4
CONFIG_NETCORE_PIXEL_RING_SLOTS=5
CONFIG_NETCORE_PIXEL_FPS=200

# 量 CPU：render 只用 mock lane（硬件層已另行驗證）。
CONFIG_NETCORE_PIXEL_MOCK_ONLY=y
# 畫波／推送分兩個 loop（trial：mock 後端先驗編譯同排程）
CONFIG_NETCORE_PX_SPLIT_PUSH=y
