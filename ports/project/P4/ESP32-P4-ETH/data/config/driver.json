{
  "version": 1,
  "_comment": [
    "應用硬件（device）層：呢份係 build 時由 ports/hardware/.../driver.json 產生的預置。",
    "現場可以直接改 /data/config/devices.json（USB 或 WebMaster），**reboot 生效**，唔使重 build。",
    "規則：device 只寫 bus:{type,index}＋型號參數；**腳位只在 hardware.json**（I80/SPI/…）。",
    "目前 firmware 真正支援：LED（ws2812 via i80）。其餘 device 寫 enable=1 會開機大聲 warn（唔會靜默）。",
    "呢個檔缺少都開得機：render 會退回 build-time 的 driver.json 設定。"
  ],
  "USB": {
    "enable": 0,
    "msc": 0,
    "cdc": 0
  },
  "TFT": {
    "enable": 0,
    "bus": {
      "type": "spi",
      "index": -1
    },
    "pins": {
      "dc": "tft_dc",
      "cs": "tft_cs",
      "rst": "tft_rst",
      "bl": "tft_bl"
    },
    "xl9555": {
      "rst": 0,
      "bl": 1
    },
    "profile": "ST7789"
  },
  "SDcard": {
    "enable": 0,
    "bus": {
      "type": "sdio",
      "index": 0
    },
    "mount": "/sd",
    "slot": 0
  },
  "WS2812": {
    "enable": 0,
    "list": [
      {
        "GPIO": null,
        "Q": 10,
        "order": "GRB",
        "dStay": 0
      }
    ]
  },
  "APA102": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "spi",
          "index": -1
        },
        "profile": "APA102"
      }
    ]
  },
  "PCA9685": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "i2c",
          "index": -1
        },
        "profile": "PCA9685"
      }
    ]
  },
  "Audio": {
    "mode": "block"
  },
  "PCM5102": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "i2s",
          "index": -1
        },
        "GPIO": {
          "xsmt": null
        },
        "profile": "PCM5102"
      }
    ]
  },
  "GT1151Q": {
    "enable": 0,
    "bus": {
      "type": "i2c",
      "index": -1
    },
    "int": "touch_int",
    "profile": "GT1151Q"
  },
  "HUSB238": {
    "enable": 0,
    "bus": {
      "type": "i2c",
      "index": -1
    },
    "profile": "HUSB238"
  },
  "uartMotor": {
    "enable": 0,
    "list": [
      {
        "bus": {
          "type": "uart",
          "index": -1
        },
        "profile": "UART_MOTOR"
      }
    ]
  }
}
